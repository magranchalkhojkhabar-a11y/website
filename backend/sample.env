# Copy this file to backend/.env for local development. Do not commit real values.

PORT=5000

# Required in all environments
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/magranchal_db?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Comma-separated frontend origins allowed to call the API.

# Required for persistent image and PDF uploads in Vercel.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: created once only if no admin account exists.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use_a_long_unique_password

# Local development only. Keep false for Vercel because its filesystem is not persistent.

