# Development leaves this empty so Vite uses its local /api proxy.
# In Vercel, set this to your deployed backend URL, without a trailing slash.
VITE_API_URL=

# Optional request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Google OAuth 2.0 Client ID (optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Only used by the local Vite proxy. Do not set this in Vercel.
VITE_LOCAL_API_URL=http://localhost:5000
